generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Add application models here.


enum CaptureType {
  NOTE
  IDEA
  LINK
  TASK
}

enum CaptureStatus {
  INBOX
  ACTIVE
  ARCHIVED
}

model Capture {
  id        String        @id @default(uuid())
  title     String?
  content   String
  type      CaptureType   @default(NOTE)
  status    CaptureStatus @default(INBOX)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
